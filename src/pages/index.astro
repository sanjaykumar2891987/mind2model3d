      let activeLang = 'en';

      function switchLang(lang) {
        activeLang = lang;
        ['en', 'hu', 'de'].forEach(l => {
          const btn = document.getElementById(`btn-${l}`);
          if (l === lang) {
            btn.className = "px-2 py-1 rounded bg-orange-500 text-slate-950 font-bold transition-all";
          } else {
            btn.className = "px-2 py-1 rounded text-slate-400 hover:text-white transition-all";
          }
        });
        document.querySelectorAll('[data-i18n]').forEach(el => {
          const key = el.getAttribute('data-i18n');
          if (translations[lang] && translations[lang][key]) {
            el.textContent = translations[lang][key];
          }
        });
      }

      let cart = [];
      const cartOverlay = document.getElementById('cart-overlay');
      const openCartBtn = document.getElementById('open-cart-btn');
      const closeCartBtn = document.getElementById('close-cart-btn');
      const badge = document.getElementById('cart-badge');
      const cartCount = document.getElementById('cart-item-count');
      const cartItemsList = document.getElementById('cart-items-list');
      const cartTotalVal = document.getElementById('cart-total-val');
      const checkoutForm = document.getElementById('checkout-order-form');
      const placeOrderBtn = document.getElementById('place-order-btn');
      const orderConfirmation = document.getElementById('order-confirmation');

      openCartBtn.addEventListener('click', () => cartOverlay.classList.remove('hidden'));
      closeCartBtn.addEventListener('click', () => cartOverlay.classList.add('hidden'));

      function addToCart(id, name, price) {
        const existing = cart.find(item => item.id === id);
        if (existing) {
          existing.qty += 1;
        } else {
          cart.push({ id, name, price, qty: 1 });
        }
        renderCart();
        cartOverlay.classList.remove('hidden');
      }

      function removeFromCart(id) {
        cart = cart.filter(item => item.id !== id);
        renderCart();
      }

      function renderCart() {
        const totalCount = cart.reduce((sum, item) => sum + item.qty, 0);
        const totalPrice = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
        badge.textContent = totalCount;
        cartCount.textContent = totalCount;
        badge.classList.toggle('hidden', totalCount === 0);
        badge.classList.toggle('flex', totalCount > 0);
        cartTotalVal.textContent = `€${totalPrice.toFixed(2)}`;

        if (cart.length === 0) {
          cartItemsList.innerHTML = `<p class="text-sm text-slate-500 text-center py-10">${translations[activeLang]['cart.empty']}</p>`;
          placeOrderBtn.disabled = true;
        } else {
          placeOrderBtn.disabled = false;
          cartItemsList.innerHTML = cart.map(item => `
            <div class="flex items-center justify-between gap-3 p-3 rounded-xl bg-slate-900 border border-slate-800">
              <div>
                <div class="font-semibold text-white text-sm">${item.name}</div>
                <div class="text-xs text-slate-400">Qty: ${item.qty} × €${item.price}</div>
              </div>
              <button onclick="removeFromCart('${item.id}')" class="text-xs text-rose-400 hover:text-rose-300 font-semibold px-2 py-1">Remove</button>
            </div>
          `).join('');
        }
      }

      checkoutForm.addEventListener('submit', (e) => {
        e.preventDefault();
        placeOrderBtn.textContent = 'Processing Order...';
        placeOrderBtn.disabled = true;
        setTimeout(() => {
          cart = [];
          renderCart();
          checkoutForm.classList.add('hidden');
          orderConfirmation.classList.remove('hidden');
        }, 700);
      });

      const heightSlider = document.getElementById('heightSlider');
      const heightVal = document.getElementById('heightVal');
      const materialSelect = document.getElementById('materialSelect');
      const estimatedPrice = document.getElementById('estimatedPrice');

      function calculateEstimate() {
        const height = parseFloat(heightSlider.value);
        const multiplier = parseFloat(materialSelect.value);
        heightVal.textContent = `${height} cm`;
        const price = Math.round(8 + (height * 1.4) * multiplier);
        estimatedPrice.textContent = price;
      }

      heightSlider.addEventListener('input', calculateEstimate);
      materialSelect.addEventListener('change', calculateEstimate);
      calculateEstimate();

const viewer = document.getElementById('main-3d-viewer');
      const activeTitle = document.getElementById('active-model-title');
      const thumbBtns = document.querySelectorAll('.model-thumb-btn');
      const prevBtn = document.getElementById('prev-model-btn');
      const nextBtn = document.getElementById('next-model-btn');

      let activeIndex = 0;
      const modelsData = Array.from(thumbBtns).map(btn => ({
        name: btn.getAttribute('data-name'),
        src: btn.getAttribute('data-src')
      }));

      function updateActiveModel(index) {
        if (!modelsData.length) return;
        activeIndex = (index + modelsData.length) % modelsData.length;
        const current = modelsData[activeIndex];

        if (viewer) viewer.setAttribute('src', current.src);
        if (activeTitle) activeTitle.textContent = current.name;

        thumbBtns.forEach((btn, i) => {
          if (i === activeIndex) {
            btn.className = "model-thumb-btn flex-shrink-0 px-4 py-2.5 rounded-xl border border-orange-500 bg-orange-500/15 text-orange-400 text-xs font-bold transition-all flex items-center gap-2";
          } else {
            btn.className = "model-thumb-btn flex-shrink-0 px-4 py-2.5 rounded-xl border border-slate-800 bg-slate-900/60 hover:border-slate-700 text-slate-300 text-xs font-bold transition-all flex items-center gap-2";
          }
        });
      }

      thumbBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          updateActiveModel(parseInt(btn.getAttribute('data-index')));
        });
      });

      prevBtn?.addEventListener('click', () => updateActiveModel(activeIndex - 1));
      nextBtn?.addEventListener('click', () => updateActiveModel(activeIndex + 1));

      updateActiveModel(0);

// Automatic Multi-Image Slider Event Handlers
  document.querySelectorAll('.product-slider').forEach(slider => {
    const images = JSON.parse(slider.getAttribute('data-images') || '[]');
    if (images.length <= 1) return;

    const imgEl = slider.querySelector('.slider-img');
    const dots = slider.querySelectorAll('.dot');
    const prevBtn = slider.querySelector('.prev-slide-btn');
    const nextBtn = slider.querySelector('.next-slide-btn');
    let currentIndex = 0;

    function showImage(index) {
      currentIndex = (index + images.length) % images.length;
      imgEl.style.opacity = '0.3';
      setTimeout(() => {
        imgEl.src = images[currentIndex];
        imgEl.style.opacity = '1';
      }, 100);

      dots.forEach((dot, i) => {
        if (i === currentIndex) {
          dot.className = 'dot w-4 h-2 rounded-full bg-orange-500 transition-all';
        } else {
          dot.className = 'dot w-2 h-2 rounded-full bg-slate-500 transition-all';
        }
      });
    }

    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      showImage(currentIndex - 1);
    });

    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      showImage(currentIndex + 1);
    });
  });

// --- Quote Form In-Page AJAX Submission ---
  const quoteForm = document.getElementById('quote-form');
  const quoteSubmitBtn = document.getElementById('quote-submit-btn');
  const quoteStatus = document.getElementById('quote-status-msg');

  quoteForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    quoteSubmitBtn.disabled = true;
    quoteSubmitBtn.textContent = 'Sending Request...';
    quoteStatus.classList.add('hidden');

    const formData = new FormData(quoteForm);

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: formData
      });
      const data = await response.json();

      if (data.success) {
        quoteStatus.textContent = '✓ Quote request sent successfully! We will review your model and email you within 24 hours.';
        quoteStatus.className = 'text-center text-sm font-semibold py-3 text-emerald-400 block';
        quoteForm.reset();
        quoteSubmitBtn.textContent = 'Sent Successfully';
      } else {
        throw new Error(data.message || 'Submission failed');
      }
    } catch (err) {
      quoteStatus.textContent = '⚠ Something went wrong. Please check your connection or email us directly.';
      quoteStatus.className = 'text-center text-sm font-semibold py-3 text-rose-400 block';
      quoteSubmitBtn.disabled = false;
      quoteSubmitBtn.textContent = 'Try Again';
    }
  });
      // ==========================================
    </script>
