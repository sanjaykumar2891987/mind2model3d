// src/pages/index.astro
import fs from 'node:fs';
import path from 'node:path';

// 1. 3D Model Scanner (Declared ONCE)
const modelsDir = path.resolve('./public/models');
let modelFiles: string[] = [];
if (fs.existsSync(modelsDir)) {
  modelFiles = fs.readdirSync(modelsDir).filter(file => file.endsWith('.glb'));
}
const modelsList = modelFiles.length > 0 
  ? modelFiles.map(file => ({
      name: file.replace('.glb', '').replace(/[-_]/g, ' '),
      url: `/models/${file}`
    }))
  : [{ name: 'Sample Astronaut', url: 'https://modelviewer.dev/shared-assets/models/Astronaut.glb' }];

// 2. Portfolio Folder Scanner
const portfolioDir = path.resolve('./public/portfolio');
let portfolioProducts = [];

if (fs.existsSync(portfolioDir)) {
  const folders = fs.readdirSync(portfolioDir, { withFileTypes: true })
    .filter(dirent => dirent.isDirectory())
    .map(dirent => dirent.name);

  portfolioProducts = folders.map(folderName => {
    const folderPath = path.join(portfolioDir, folderName);
    const validExts = ['.jpg', '.jpeg', '.png', '.webp'];
    const imageFiles = fs.readdirSync(folderPath)
      .filter(f => validExts.includes(path.extname(f).toLowerCase()))
      .map(f => `/portfolio/${folderName}/${f}`);

    let info = {
      name: folderName.replace(/[-_]/g, ' '),
      price: 25,
      tag: 'Custom Print',
      material: 'PLA / PETG',
      desc: 'Precision custom 3D print manufactured with tight layer tolerances.'
    };

    const infoPath = path.join(folderPath, 'info.json');
    if (fs.existsSync(infoPath)) {
      try {
        const fileContent = fs.readFileSync(infoPath, 'utf-8');
        info = { ...info, ...JSON.parse(fileContent) };
      } catch (err) {
        console.warn(`Could not parse info.json in ${folderName}`);
      }
    }

    return {
      id: folderName,
      ...info,
      images: imageFiles.length > 0 ? imageFiles : ['https://placehold.co/600x400/0f172a/f97316?text=No+Photo']
    };
  });
}
